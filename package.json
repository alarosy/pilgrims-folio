{
  "name": "pilgrims-folio",
  "private": true,
  "version": "0.2.0",
  "description": "A companion website for Ali's 100-hour Shakespeare journey.",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/postbuild.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "setup:wasm": "node scripts/setup-wasm.mjs"
  },
  "overrides": {
    "lightningcss": "npm:lightningcss-wasm@1.33.0"
  },
  "dependencies": {
    "@fontsource-variable/eb-garamond": "5.3.0",
    "@fontsource/amiri": "5.3.0",
    "@fontsource/im-fell-dw-pica": "5.3.0",
    "@fontsource/im-fell-english": "5.3.0",
    "@fontsource/unifrakturmaguntia": "5.3.0",
    "@react-router/node": "8.5.0",
    "gsap": "3.15.1",
    "isbot": "5.1.32",
    "lenis": "1.3.27",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.5.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
